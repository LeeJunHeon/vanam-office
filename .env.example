DATABASE_URL="postgresql://<user>:<pass>@<host>:<port>/<db>"
# 첨부 저장 루트(비워두면 ./uploads 사용)
UPLOAD_DIR=

# 인증 (next-auth v5) — 값은 다른 앱과 동일하게 채워넣을 것
NEXTAUTH_URL=http://localhost:3000
AUTH_SECRET=          # 다른 앱과 "동일한" 시크릿 (다른 앱이 NEXTAUTH_SECRET을 쓰면 그 이름·값 그대로 넣을 것)
GOOGLE_CLIENT_ID=     # 다른 앱과 동일
GOOGLE_CLIENT_SECRET= # 다른 앱과 동일
DISABLE_AUTH=true     # 로컬 UI 확인용 (배포 시 제거 또는 false)
